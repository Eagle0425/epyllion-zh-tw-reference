{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "locale",
    "date",
    "content_files",
    "roles",
    "expected_entries",
    "quality_policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "const": "zh-TW"
    },
    "date": {
      "type": "string"
    },
    "content_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9-]+\\.json$"
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "image"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "image": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "expected_entries": {
      "type": "integer",
      "minimum": 1
    },
    "quality_policy": {
      "type": "object"
    },
    "workflow_context": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
